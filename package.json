{
  "name": "@purecontext/backup",
  "version": "0.4.2",
  "description": "SQLite backup service: continuous Litestream replication plus verified, rotated snapshots to a folder you choose",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "restore": "node dist/restore.js",
    "prepublishOnly": "tsc",
    "test": "tsc && node --test --test-concurrency=1 test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/purecontext/purecontext-backup.git"
  },
  "license": "MIT",
  "keywords": ["litestream", "sqlite", "backup", "replication", "s3", "snapshots"],
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome"]
  },
  "bin": {
    "purecontext-backup": "dist/cli.js"
  }
}
